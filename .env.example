# ============================================================
# RetailIQ — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ----- App -----
APP_NAME=RetailIQ
APP_ENV=development        # development | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string-in-production
DEBUG=true

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://retailiq:retailiq_pass@localhost:5432/retailiq
DATABASE_URL_SYNC=postgresql://retailiq:retailiq_pass@localhost:5432/retailiq
SQLITE_URL=sqlite:///./local_edge.db

# ----- JWT -----
JWT_SECRET_KEY=change-me-jwt-secret-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Simulation -----
SIMULATION_MODE=true          # true = use simulator, false = real camera
SIMULATOR_TICK_SECONDS=2      # how often the simulator ticks
SIMULATOR_STORE_ID=1

# ----- Edge AI -----
YOLO_MODEL_PATH=yolov8n.pt    # auto-downloaded if not present
YOLO_CONFIDENCE=0.4
FRAME_SKIP=3                  # process every Nth frame
FPS_LIMIT=10
CAMERA_SOURCE=0               # 0=webcam, /path/to/video.mp4, rtsp://...

# ----- WebSocket -----
WS_HEARTBEAT_SECONDS=30

# ----- Admin seed user -----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@retailiq.local
ADMIN_PASSWORD=admin123

# ----- Feature flags -----
ENABLE_OFFLINE_MODE=true
ENABLE_EDGE_PIPELINE=false    # set true when running edge module
ENABLE_REAL_YOLO=false        # set true when YOLO weights available
